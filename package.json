{
  "name": "fangcun-toolbox",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:preview": "node scripts/preview/build-preview.mjs",
    "build:vercel-preview": "node scripts/preview/build-preview.mjs vercel-preview",
    "build:root-domain": "vite build --mode root-domain",
    "preview": "vite preview",
    "preview:console": "npm run build:preview && vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "review:console": "node scripts/visual-review/review-console.mjs",
    "pretest": "npm run build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:root-domain": "npm run build:root-domain && FANGCUN_BUILD_TARGET=root-domain node --test tests/root-domain-build.test.mjs"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.33.0",
    "pdfjs-dist": "^6.2.108",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.6.0",
    "thinking-orbs": "file:vendor/thinking-orbs",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "ffmpeg-static": "^5.3.0",
    "globals": "16.4.0",
    "playwright": "^1.62.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  },
  "type": "module"
}
