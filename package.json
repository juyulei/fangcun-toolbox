{
  "name": "fangcun-toolbox",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:root-domain": "vite build --mode root-domain",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:root-domain": "npm run build:root-domain && FANGCUN_BUILD_TARGET=root-domain node --test tests/root-domain-build.test.mjs"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "thinking-orbs": "file:vendor/thinking-orbs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  },
  "type": "module"
}
